# Cookie Pulse — every value below is also the built-in default, so the app runs with no .env at all.

# Browser talks to these directly (must be NEXT_PUBLIC_).
NEXT_PUBLIC_RPC_URL=https://rpc.cookiescan.io
# The RPC host serves the WebSocket too; the dedicated `wss.` subdomain does not — see NOTES.md.
NEXT_PUBLIC_WS_URL=wss://rpc.cookiescan.io
NEXT_PUBLIC_EXPLORER_URL=https://cookiescan.io

# Server-only: reached from /api/* route handlers, never from the browser.
COOKIESCAN_API_URL=https://api.cookiescan.io
COOKIEBOX_AGG_URL=https://agg.cookiebox.app
CANDYSHOP_API_URL=https://swap.cookiescan.io/api
